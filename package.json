{
  "name": "learning-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/validate-production-environment.ts --vercel-production && prisma generate && next build --webpack && tsx scripts/deploy-production-migrations.ts",
    "start": "next start",
    "lint": "eslint",
    "typegen": "prisma generate && next typegen",
    "typecheck": "pnpm typegen && tsc --noEmit --incremental false",
    "db:deploy": "prisma migrate deploy",
    "env:check": "tsx scripts/validate-production-environment.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "admin:promote:apply": "tsx scripts/promote-admin.ts --apply",
    "test": "vitest run",
    "videos:sign": "tsx scripts/migrate-videos-to-signed.ts",
    "videos:sign:apply": "tsx scripts/migrate-videos-to-signed.ts --apply",
    "videos:reset": "tsx scripts/reset-dangling-videos.ts",
    "videos:reset:apply": "tsx scripts/reset-dangling-videos.ts --apply",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@mux/mux-node": "^14.0.1",
    "@mux/mux-player-react": "^3.13.4",
    "@mux/mux-uploader-react": "^1.5.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^10.75.0",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.5",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.28.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
