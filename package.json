{
  "name": "learning-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "videos:sign": "tsx scripts/migrate-videos-to-signed.ts",
    "videos:sign:apply": "tsx scripts/migrate-videos-to-signed.ts --apply",
    "videos:reset": "tsx scripts/reset-dangling-videos.ts",
    "videos:reset:apply": "tsx scripts/reset-dangling-videos.ts --apply",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@mux/mux-node": "^14.0.1",
    "@mux/mux-player-react": "^3.13.0",
    "@mux/mux-uploader-react": "^1.5.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.1.1",
    "next": "16.2.11",
    "next-auth": "^4.24.15",
    "next-intl": "^4.13.5",
    "nodemailer": "^7.0.7",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "sharp": "^0.35.3",
    "stripe": "^22.1.1",
    "zod": "^4.4.1"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.3"
    },
    "onlyBuiltDependencies": [
      "esbuild@0.28.1"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
